# Copy to `.env` or `.env.local` and fill in values. Never commit real secrets.

# --- App ---
DATABASE_URL="file:./dev.db"
AUTH_SECRET=""
ADMIN_PASSWORD=""

# --- LINE 老師端（北部 / 南部各一組 Messaging API）---
# Channel secret / Channel access token from LINE Developers
LINE_NORTH_SECRET=""
LINE_NORTH_TOKEN=""
LINE_SOUTH_SECRET=""
LINE_SOUTH_TOKEN=""

# --- LINE 園所端（課程回報轉傳；測試時換另一組 OA 只要改這兩個變數）---
LINE_SCHOOL_SECRET=""
LINE_SCHOOL_TOKEN=""
LINE_SCHOOL2_SECRET=""
LINE_SCHOOL2_TOKEN=""

# --- Cron（例如 /api/cron/reminder，Authorization: Bearer …）---
CRON_SECRET=""

# --- Optional: Turso ---
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""

# --- Optional: 薪資條 email ---
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""
# BACKUP_EMAIL=""

# --- Optional: 課後回報同步 Google Sheet ---
GOOGLE_SHEETS_SYNC_ENABLED="false"
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_TAB_MAP_JSON='{"2026-09":"115-9月"}'
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# 教師敏感文件使用 private Blob store
SENSITIVE_READ_WRITE_TOKEN=

# 課程照片必須使用 private Blob store；不得改成 public 以繞過錯誤。
# 未填時沿用 BLOB_READ_WRITE_TOKEN，但仍只允許 private 上傳。
REPORT_PHOTO_READ_WRITE_TOKEN=
# 既有公開照片的刪除仍需原公開桶的 token，遷移完成前請保留。
BLOB_READ_WRITE_TOKEN=
